rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // employees/{uid}: uid, employeeCode (1-9 ASCII digits), fullName, phone, email,
    //   optional photoURL/facebookUrl and optional bankName/bankAccountName/
    //   bankAccountNumber, role, status, joinDate, createdAt, updatedAt
    // workSchedules/{id}: employeeId, date, shift, status, note, optional reviewNote,
    //   optional reviewedBy/reviewedAt/lockedAt, createdAt, updatedAt
    // leaveRequests/{id}: employeeId, optional workScheduleId, leaveDate,
    //   optional endDate/duration, leaveType, reason, status,
    //   optional approvedBy/reviewNote/reviewedBy/reviewedAt, createdAt, updatedAt
    // lateRequests/{id}: employeeId, workScheduleId, date, shift,
    //   lateMinutes, optional expectedArrival, reason, status,
    //   optional approvedBy/reviewNote/reviewedBy/reviewedAt, createdAt, updatedAt
    // salaryAdvances/{id}: employeeId, amount, reason, status,
    //   optional approvedBy/reviewNote/reviewedBy/reviewedAt, createdAt, updatedAt
    // staffRequests/{id}: employeeId, type, content, optional weekStart/shifts,
    //   status, optional reviewNote/reviewedBy/reviewedAt, createdAt, updatedAt
    // penalties/{id}: employeeId, title, description, category, amount,
    //   penaltyDate, createdBy, optional sourceType/sourceId, createdAt
    // companyRules/{id}: title, content, order, isActive, createdAt, updatedAt
    // notifications/{id}: employeeId, title, message, type, isRead, createdAt
    // employees/{uid}/notificationDevices/{fid}: employeeId, fid, platform,
    //   permission, createdAt, updatedAt, lastSeenAt
    // workflowRequests/{id}, pushDispatches/{id}: server-only idempotency/outbox docs
    // auditEvents/{id}: append-only server audit records, readable by the
    //   affected employee and management; auditHeads/auditEmailOutbox are server-only
    // factoryManagerSeats/{factoryId}: server-only management seat owned by
    //   a factory, with the UID of the account currently occupying that seat

    // ===============================================================
    // Authentication and authorization helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    function uidUnchanged() {
      return isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function hasEmployeeProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function hasActiveEmployeeProfile() {
      let profile = get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
      return hasEmployeeProfile() && profile.status == 'active' &&
        (!('sessionsValidAfter' in profile) || request.auth.token.auth_time > profile.sessionsValidAfter);
    }

    function currentRole() {
      return get(
        /databases/$(database)/documents/employees/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return hasActiveEmployeeProfile() && currentRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return hasActiveEmployeeProfile() &&
        currentRole() in ['manager', 'admin'];
    }

    function isDirector() {
      return hasActiveEmployeeProfile() && currentRole() == 'director';
    }

    function currentFactoryId() {
      let value = get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.factoryId;
      return value in ['factory-1', 'factory-2'] ? value : 'factory-1';
    }

    function resourceFactoryId() {
      // A default/ternary here cannot safely constrain collection queries.
      // Legacy documents must be migrated explicitly before enforcement.
      return resource.data.factoryId;
    }

    function canReadFactoryResource() {
      return isDirector() || (isManagerOrAdmin() && resourceFactoryId() == currentFactoryId());
    }

    function ownsResource(fieldName) {
      return isAuthenticated() && hasActiveEmployeeProfile() &&
        resource.data[fieldName] == request.auth.uid;
    }

    // ===============================================================
    // Shared validation helpers
    // ===============================================================
    function validString(value, minLength, maxLength) {
      return value is string &&
        value.size() >= minLength &&
        value.size() <= maxLength;
    }

    function validEmail(value) {
      return validString(value, 3, 254) &&
        value.matches('^.+@.+\\..+$');
    }

    function validOptionalUrl(data, fieldName) {
      return !(fieldName in data) ||
        (
          validString(data[fieldName], 0, 500) &&
          (
            data[fieldName] == '' ||
            data[fieldName].matches('^https?://.*')
          )
        );
    }

    function validOptionalBankAccount(data) {
      return (
          !('bankName' in data) &&
          !('bankAccountName' in data) &&
          !('bankAccountNumber' in data)
        ) ||
        (
          validString(data.bankName, 2, 100) &&
          validString(data.bankAccountName, 2, 150) &&
          validString(data.bankAccountNumber, 6, 24) &&
          data.bankAccountNumber.matches('^[0-9]+$')
        );
    }

    function recentTimestamp(value) {
      return value is timestamp &&
        value >= request.time - duration.value(10, 'm') &&
        value <= request.time + duration.value(10, 'm');
    }

    function timestampsValidOnCreate(data) {
      return recentTimestamp(data.createdAt) &&
        recentTimestamp(data.updatedAt);
    }

    function timestampsValidOnUpdate(data) {
      return data.createdAt == resource.data.createdAt &&
        recentTimestamp(data.updatedAt);
    }

    // ===============================================================
    // Domain validators
    // ===============================================================
    function validEmployeeCode(data) {
      // New profiles must use 1-9 digits. An unchanged legacy code remains
      // readable/updateable until management assigns an explicit numeric code.
      return (validString(data.employeeCode, 1, 9) &&
          data.employeeCode.matches('^[0-9]{1,9}$')) ||
        data.employeeCode == resource.data.employeeCode;
    }

    function validEmployee(data) {
      return data.keys().hasAll([
          'uid', 'employeeCode', 'fullName', 'phone', 'email', 'factoryId',
          'role', 'status', 'joinDate', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'employeeCode', 'fullName', 'phone', 'email', 'factoryId',
          'photoURL', 'facebookUrl', 'bankName', 'bankAccountName', 'bankAccountNumber',
          'role', 'status', 'joinDate', 'createdAt', 'updatedAt',
          'scheduleMode', 'scheduleModeEffectiveWeekStart', 'fixedScheduleNeedsSetupWeekStart', 'fixedScheduleTemplateWeekStart',
          'scheduleModeInitialSelectionDeadlineAt', 'scheduleModeInitialSelectionCompletedAt', 'scheduleModeChangeCooldownUntil',
          'hasSubmittedSchedule', 'reactivatedAt', 'reactivationScheduleWaiverWeekStart',
          'statusChangedBy', 'statusChangedAt', 'roleChangedBy', 'roleChangedAt', 'sessionsValidAfter'
        ]) &&
        validString(data.uid, 1, 128) &&
        validEmployeeCode(data) &&
        validString(data.fullName, 1, 100) &&
        validString(data.phone, 0, 30) &&
        validOptionalUrl(data, 'photoURL') &&
        validOptionalUrl(data, 'facebookUrl') &&
        validOptionalBankAccount(data) &&
        validEmail(data.email) &&
        data.factoryId in ['factory-1', 'factory-2'] &&
        data.role in ['admin', 'manager', 'director', 'employee'] &&
        data.status in ['pending', 'active', 'inactive'] &&
        (!('scheduleMode' in data) || data.scheduleMode in ['rotating', 'fixed']) &&
        (!('scheduleModeEffectiveWeekStart' in data) || validString(data.scheduleModeEffectiveWeekStart, 10, 10)) &&
        (!('fixedScheduleNeedsSetupWeekStart' in data) || validString(data.fixedScheduleNeedsSetupWeekStart, 10, 10)) &&
        (!('fixedScheduleTemplateWeekStart' in data) || validString(data.fixedScheduleTemplateWeekStart, 10, 10)) &&
        (!('scheduleModeInitialSelectionDeadlineAt' in data) || data.scheduleModeInitialSelectionDeadlineAt is timestamp) &&
        (!('scheduleModeInitialSelectionCompletedAt' in data) || data.scheduleModeInitialSelectionCompletedAt is timestamp) &&
        (!('scheduleModeChangeCooldownUntil' in data) || data.scheduleModeChangeCooldownUntil is timestamp) &&
        (!('hasSubmittedSchedule' in data) || data.hasSubmittedSchedule is bool) &&
        (!('reactivatedAt' in data) || data.reactivatedAt is timestamp) &&
        (!('reactivationScheduleWaiverWeekStart' in data) || validString(data.reactivationScheduleWaiverWeekStart, 10, 10)) &&
        (!('statusChangedBy' in data) || validString(data.statusChangedBy, 1, 128)) &&
        (!('statusChangedAt' in data) || data.statusChangedAt is timestamp) &&
        (!('roleChangedBy' in data) || validString(data.roleChangedBy, 1, 128)) &&
        (!('roleChangedAt' in data) || data.roleChangedAt is timestamp) &&
        (!('sessionsValidAfter' in data) || (data.sessionsValidAfter is int && data.sessionsValidAfter >= 0)) &&
        data.joinDate is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validCompanyRule(data) {
      return data.keys().hasAll([
          'title', 'content', 'order', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'content', 'order', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        validString(data.title, 1, 150) &&
        validString(data.content, 1, 5000) &&
        data.order is int &&
        data.order >= 0 &&
        data.order <= 10000 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validNotification(data) {
      return data.keys().hasAll([
          'employeeId', 'title', 'message', 'type',
          'isRead', 'createdAt'
        ]) &&
        // Server-generated metadata is immutable, but may remain on the doc.
        data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        validString(data.employeeId, 1, 128) &&
        validString(data.title, 1, 150) &&
        validString(data.message, 1, 2000) &&
        data.type in ['info', 'success', 'warning', 'error'] &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    // ===============================================================
    // Collection access rules
    // ===============================================================
    match /employees/{uid} {
      allow read: if isOwner(uid) || isDirector() || (isManagerOrAdmin() && resourceFactoryId() == currentFactoryId());

      // Account creation and employee-code reservation are atomic server workflows.
      allow create: if false;

      allow update: if validEmployee(request.resource.data) &&
        timestampsValidOnUpdate(request.resource.data) &&
        uidNotModified() &&
        uidUnchanged() &&
        request.resource.data.uid == resource.data.uid &&
        (
          (
            isDocOwner() && hasActiveEmployeeProfile() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'fullName', 'phone', 'photoURL', 'facebookUrl',
                'bankName', 'bankAccountName', 'bankAccountNumber', 'updatedAt'
              ]) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status
          )
        );

      // Status and role changes are server-only workflows. In particular, an
      // Admin xưởng cannot grant roles through a direct Firestore write.
      allow delete: if false;
    }

    match /factoryManagerSeats/{factoryId} {
      allow read, write: if false;
    }

    match /employeeCodes/{code} {
      allow read, write: if false;
    }

    match /workSchedules/{scheduleId} {
      allow read: if ownsResource('employeeId') || canReadFactoryResource();
      // Firebase Admin SDK bypasses Rules only inside the trusted Next.js backend.
      allow create, update, delete: if false;
    }

    match /leaveRequests/{leaveId} {
      allow read: if ownsResource('employeeId') || canReadFactoryResource();
      allow create, update, delete: if false;
    }

    match /lateRequests/{lateId} {
      allow read: if ownsResource('employeeId') || canReadFactoryResource();
      allow create, update, delete: if false;
    }

    match /salaryAdvances/{advanceId} {
      // Director salary data is served through the approved-only backend endpoint.
      allow read: if ownsResource('employeeId') ||
        (isManagerOrAdmin() && resourceFactoryId() == currentFactoryId());
      allow create, update, delete: if false;
    }

    match /staffRequests/{requestId} {
      allow read: if ownsResource('employeeId') || canReadFactoryResource();
      allow create, update, delete: if false;
    }

    match /penalties/{penaltyId} {
      allow read: if ownsResource('employeeId') || canReadFactoryResource();
      allow create, update, delete: if false;
    }

    match /companyRules/{ruleId} {
      allow read: if isAuthenticated() && hasActiveEmployeeProfile() &&
        (resource.data.isActive == true || isAdmin());

      allow create: if isAdmin() &&
        validCompanyRule(request.resource.data) &&
        timestampsValidOnCreate(request.resource.data);

      allow update: if isAdmin() &&
        validCompanyRule(request.resource.data) &&
        timestampsValidOnUpdate(request.resource.data);

      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if ownsResource('employeeId');
      allow create: if false;

      allow update: if ownsResource('employeeId') &&
        validNotification(request.resource.data);

      allow delete: if ownsResource('employeeId');
    }

    match /workflowRequests/{requestId} {
      allow read, write: if false;
    }

    match /pushDispatches/{dispatchId} {
      allow read, write: if false;
    }

    match /auditEvents/{eventId} {
      // No default factory fallback for legacy audits: an unscoped event may
      // contain payloads from either branch. Host and the subject retain access.
      allow read: if ownsResource('subjectEmployeeId') || isDirector() ||
        (isManagerOrAdmin() && 'factoryId' in resource.data && resource.data.factoryId == currentFactoryId());
      allow create, update, delete: if false;
    }

    match /auditHeads/{employeeId} {
      allow read, write: if false;
    }

    match /auditEmailOutbox/{messageId} {
      allow read, write: if false;
    }

    match /managementSettings/{settingId} {
      allow read, write: if false;
    }

    match /employees/{uid}/notificationDevices/{fid} {
      allow read: if isOwner(uid) && hasActiveEmployeeProfile();
      // Server transaction enforces an account-wide maximum of five devices.
      allow create, update: if false;
      allow delete: if isOwner(uid) && hasActiveEmployeeProfile();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
